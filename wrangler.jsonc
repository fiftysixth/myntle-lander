{
  "$schema": "./node_modules/wrangler/config-schema.json", "name": "myntle-landing", "main": ".open-next/worker.js", "compatibility_date": 
  "2026-11-13", "compatibility_flags": [
    "nodejs_compat", "global_fetch_strictly_public"
  ], "assets": {
    "directory": ".open-next/assets", "binding": "ASSETS"
  }, "services": [
    {
      "binding": "WORKER_SELF_REFERENCE", "service": "myntle-landing"
    }
  ], "images": {
    "binding": "IMAGES"
  }, "observability": {
    "enabled": true
  } // Uncomment after the domain's zone is active in this account. // "routes": [ // { "pattern": "myntle.xyz", "custom_domain": true } // ]
}
