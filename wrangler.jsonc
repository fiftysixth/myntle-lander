{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myntle-landing",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "myntle-landing"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }

  // To attach the domain, add a comma after the closing brace above
  // and uncomment the route below:
  // "routes": [{ "pattern": "myntle.xyz", "custom_domain": true }]
}
